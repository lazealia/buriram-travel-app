<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= appName %> | ตลาดชุมชน</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Kanit', sans-serif; background-color: #fcfcfd; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .category-pill.active { background-color: #ea580c; color: white; border-color: #ea580c; }
        .product-card { transition: transform 0.2s ease; }
        #modalDescription ul { list-style-type: disc; margin-left: 1.25rem; margin-top: 0.5rem; margin-bottom: 0.5rem; }
        #modalDescription p { margin-bottom: 0.5rem; }
        #modalDescription strong { font-weight: 700; color: #374151; }
        
        /* ป้องกัน Nav ทับ Modal */
        #productModal { z-index: 9999; } 
    </style>
</head>
<body class="pb-24">

    <header class="bg-orange-500 px-5 pt-8 pb-4 rounded-b-[30px] shadow-lg shadow-orange-100/50 sticky top-0 z-50">
        <div class="flex flex-col gap-3">
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2 flex-shrink-0">
                    <div class="bg-white/20 w-8 h-8 rounded-lg flex items-center justify-center text-white backdrop-blur-md border border-white/30">
                        <i class="fa-solid fa-basket-shopping text-sm"></i>
                    </div>
                    <div>
                        <h1 class="text-base font-black text-white leading-none tracking-tight">ตลาดชุมชน</h1>
                        <p class="text-[9px] text-orange-100 font-medium uppercase tracking-tighter mt-1">Buriram Best Selection</p>
                    </div>
                </div>
                <form action="/shop" method="GET" class="flex-1 bg-white/10 backdrop-blur-md rounded-xl p-1 flex items-center border border-white/20">
                    <div class="w-7 h-7 flex items-center justify-center text-orange-100">
                        <i class="fa-solid fa-magnifying-glass text-[10px]"></i>
                    </div>
                    <input type="hidden" name="category" value="<%= pagination.category %>">
                    <input type="text" name="search" value="<%= pagination.search %>"
                        placeholder="ค้นหาของดี..." 
                        class="flex-1 bg-transparent border-none focus:ring-0 text-xs text-white placeholder:text-orange-100/60 py-1 outline-none">
                </form>
            </div>
        </div>
    </header>

    <div class="px-4 mt-6 mb-2 flex space-x-2 overflow-x-auto no-scrollbar py-2">
        <% ['ทั้งหมด', 'กิจกรรมท่องเที่ยว','ของกิน', 'ผลไม้', 'ของใช้', 'ผ้าไหม', 'สุขภาพ'].forEach((cat) => { %>
            <a href="/shop?category=<%= cat %>&search=<%= pagination.search %>" 
                class="category-pill <%= pagination.category === cat ? 'active' : '' %> whitespace-nowrap px-6 py-2 rounded-full border border-orange-200 text-xs font-bold text-orange-600 bg-white shadow-sm transition-all">
                <%= cat %>
            </a>
        <% }); %>
    </div>

    <main id="productGrid" class="p-4 grid grid-cols-2 gap-4">
        <% products.forEach(function(item) { 
            let actionUrl = '#'; 
            let btnText = 'สอบถาม';
            let btnClass = 'bg-slate-500';
            let btnIcon = 'fa-comment-dots';

            const oLink = (item.serviceOrder?.OrderLink || '').trim();
            const bLink = (item.serviceOrder?.BookingLink || '').trim();
            const bStatus = item.serviceOrder?.BookingStatus;
            const tel = (item.serviceContact?.Telephone || '').trim();
            const line = (item.serviceContact?.Line || '').trim();
            const fb = (item.serviceContact?.Facebook || '').trim();
            const tiktok = (item.serviceContact?.TikTok || '').trim();
            const email = (item.serviceContact?.Email || '').trim();
            const sCode = item.serviceCode || '';

            const isNoData = (val) => {
                if (!val) return true;
                const v = val.toLowerCase();
                return v === '' || v === '-' || v === 'null' || v.includes('ไม่ระบุ') || v.includes('ไม่ได้ระบุ') || v.includes('xxx');
            };

            if (oLink && !isNoData(oLink)) {
                actionUrl = oLink;
                btnText = 'ซื้อเลย'; btnClass = 'bg-green-600'; btnIcon = 'fa-cart-shopping';
            } else if (bLink && !isNoData(bLink) && bStatus === 'on') {
                actionUrl = bLink;
                btnText = 'จองสินค้า'; btnClass = 'bg-orange-500'; btnIcon = 'fa-calendar-check';
            } else if (!isNoData(line)) {
                actionUrl = line.startsWith('http') ? line : `https://line.me/ti/p/~${line}`;
                btnText = 'คุยไลน์'; btnClass = 'bg-green-500'; btnIcon = 'fa-brands fa-line';
            } else if (!isNoData(tel)) {
                actionUrl = `tel:${tel}`;
                btnText = 'โทรสอบถาม'; btnClass = 'bg-blue-600'; btnIcon = 'fa-solid fa-phone';
            }

            const ownerName = item.serviceContact?.OwnerName || 'ร้านค้าชุมชน';
            const priceText = item.servicePrice > 0 ? '฿' + item.servicePrice : 'สอบถามราคา';
            
            const combinedDetail = `
                ${(item.servicePromotion && !item.servicePromotion.includes('null')) ? `<div class="mb-4 p-3 bg-orange-50 rounded-xl border border-orange-100 text-orange-700">${item.servicePromotion}</div>` : ''}
                ${(item.serviceDetail && !item.serviceDetail.includes('null')) ? `<div>${item.serviceDetail}</div>` : ''}
                ${(item.serviceAbsorptive && !item.serviceAbsorptive.includes('null')) ? `<div class="mt-4 pt-4 border-t border-gray-100">${item.serviceAbsorptive}</div>` : ''}
            `.trim() || 'ไม่มีรายละเอียดสินค้าเพิ่มเติม';
        %>
            <div class="product-card bg-white rounded-[30px] shadow-sm border border-orange-50 overflow-hidden flex flex-col active:scale-95 transition-all">
                <div class="h-44 relative overflow-hidden bg-gray-50 cursor-zoom-in"
                    onclick='openProductModal(<%= JSON.stringify(item.serviceName) %>, <%= JSON.stringify(combinedDetail) %>, "<%= item.serviceImage %>", <%= JSON.stringify(ownerName) %>, "<%= tel %>", "<%= priceText %>", "<%= actionUrl %>", "<%= btnText %>", "<%= btnClass %>", "<%= btnIcon %>", "<%= fb %>", "<%= line %>", "<%= tiktok %>", "<%= email %>", "<%= sCode %>")'>
                    <img src="<%= item.serviceImage %>" class="w-full h-full object-cover" loading="lazy">
                    <div class="absolute bottom-3 right-3 bg-black/40 backdrop-blur-md text-white text-[8px] px-2 py-1 rounded-full flex items-center gap-1">
                        <i class="fa-solid fa-expand"></i> รายละเอียด
                    </div>
                </div>

                <div class="p-3 flex-grow flex flex-col">
                    <h3 class="text-[13px] font-bold text-gray-800 line-clamp-1 mb-0.5"><%= item.serviceName %></h3>
                    <div class="flex items-center gap-1 mb-3 text-gray-400">
                        <i class="fa-solid fa-store text-[9px] text-orange-400"></i>
                        <span class="text-[10px] line-clamp-1 font-medium"><%= ownerName %></span>
                    </div>
                    <div class="mt-auto flex items-center justify-between">
                        <p class="text-sm font-black text-orange-600"><%= priceText %></p>
                        <div onclick="window.open(`<%= actionUrl %>`, '_blank')" 
                            class="<%= btnClass %> text-white px-2 py-1.5 rounded-xl flex items-center gap-1 shadow-md cursor-pointer active:opacity-80 transition-opacity">
                            <i class="fa-solid <%= btnIcon %> text-[10px]"></i>
                            <span class="text-[9px] font-bold text-nowrap"><%= btnText %></span>
                        </div>
                    </div>
                </div>
            </div>
        <% }); %>
    </main>

    <div id="productModal" class="fixed inset-0 hidden flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity" onclick="closeProductModal()"></div>
        
        <div id="modalContent" class="relative w-full max-w-lg bg-white rounded-t-[40px] sm:rounded-[40px] overflow-hidden transform translate-y-full transition-transform duration-300 ease-out shadow-2xl flex flex-col max-h-[92vh] pb-24 sm:pb-0">
            
            <div class="sticky top-0 bg-white/95 backdrop-blur-md px-6 py-4 border-b border-gray-50 flex justify-between items-center z-20">
                <div>
                    <h2 id="modalTitle" class="text-base font-bold text-gray-800 truncate pr-4"></h2>
                    <p id="modalOwner" class="text-[10px] text-orange-500 font-medium"></p>
                </div>
                <button onclick="closeProductModal()" class="w-8 h-8 flex items-center justify-center bg-gray-100 rounded-full text-gray-400">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>
            
            <div class="overflow-y-auto p-6 no-scrollbar flex-1">
                <img id="modalImage" src="" class="w-full h-64 object-cover rounded-[30px] mb-4 shadow-sm">
                
                <div id="videoContainer" class="hidden mb-6 rounded-[30px] overflow-hidden aspect-video bg-black shadow-lg">
                    <iframe id="modalVideoFrame" class="w-full h-full" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>

                <div class="flex items-center justify-between mb-6 bg-orange-50 p-4 rounded-2xl border border-orange-100">
                    <div>
                        <p class="text-[10px] text-orange-400 uppercase font-bold tracking-wider">ราคาเสนอขาย</p>
                        <p id="modalPrice" class="text-xl font-black text-orange-600"></p>
                    </div>
                    <div class="text-right">
                        <p class="text-[10px] text-gray-400 font-bold uppercase tracking-wider mb-2">ช่องทางติดต่อ</p>
                        <div class="flex justify-end gap-4 text-xl">
                            <a id="linkTel" href="#" class="text-blue-600 hidden"><i class="fa-solid fa-phone"></i></a>
                            <a id="linkLine" href="#" target="_blank" class="text-green-500 hidden"><i class="fa-brands fa-line"></i></a>
                            <a id="linkFB" href="#" target="_blank" class="text-blue-700 hidden"><i class="fa-brands fa-facebook"></i></a>
                            <a id="linkTikTok" href="#" target="_blank" class="text-gray-900 hidden"><i class="fa-brands fa-tiktok"></i></a>
                            <a id="linkEmail" href="#" class="text-red-500 hidden"><i class="fa-solid fa-envelope"></i></a>
                        </div>
                    </div>
                </div>

                <div class="prose prose-sm max-w-none">
                    <div class="flex items-center justify-between mb-3">
                        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest flex items-center gap-2">
                            <i class="fa-solid fa-circle-info text-orange-400"></i> รายละเอียดสินค้า
                        </h4>
                        <button id="modalShareBtn" class="flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 rounded-full text-slate-500 text-[10px] font-bold active:scale-95 transition-all">
                            <i class="fa-solid fa-share-nodes"></i> แชร์
                        </button>
                    </div>
                    <div id="modalDescription" class="text-[13px] text-gray-600 leading-relaxed mb-10"></div>
                </div>
            </div>

            <div class="p-6 bg-white border-t border-gray-50 z-30">
                <a id="modalActionBtn" href="#" target="_blank" class="w-full py-4 rounded-2xl shadow-lg flex items-center justify-center gap-3 text-white font-bold transition-transform active:scale-95 min-h-[56px]">
                    <i id="modalActionIcon" class="fa-solid"></i>
                    <span id="modalActionText"></span>
                </a>
            </div>
        </div>
    </div>
    <% if (pagination.total > 1) { %>
        <div class="flex justify-center items-center gap-2 pb-10 mt-4">
            <% if (pagination.hasPrev) { %>
                <a href="/shop?page=<%= pagination.current - 1 %>&category=<%= pagination.category %>&search=<%= pagination.search %>" 
                   class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-orange-100 text-orange-600 shadow-sm active:scale-90 transition-transform">
                    <i class="fa-solid fa-chevron-left text-xs"></i>
                </a>
            <% } %>

            <div class="flex items-center gap-1 bg-white px-3 py-2 rounded-xl border border-orange-50 shadow-sm">
                <span class="text-xs font-bold text-orange-600"><%= pagination.current %></span>
                <span class="text-[10px] text-gray-400">/</span>
                <span class="text-xs font-medium text-gray-500"><%= pagination.total %></span>
            </div>

            <% if (pagination.hasNext) { %>
                <a href="/shop?page=<%= pagination.current + 1 %>&category=<%= pagination.category %>&search=<%= pagination.search %>" 
                   class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-orange-100 text-orange-600 shadow-sm active:scale-90 transition-transform">
                    <i class="fa-solid fa-chevron-right text-xs"></i>
                </a>
            <% } %>
        </div>
    <% } %>
    <%- include('partials/nav') %>

    <script>
        const isInvalidValue = (val) => {
            if (!val) return true;
            const v = val.toString().toLowerCase();
            return v === 'null' || v === '-' || v === '' || v.includes('ไม่ระบุ') || v.includes('ไม่ได้ระบุ') || v.includes('xxx');
        };

        async function openProductModal(name, detail, image, owner, tel, price, actionUrl, btnText, btnClass, btnIcon, fb, line, tiktok, email, sCode) {
            const modal = document.getElementById('productModal');
            const content = document.getElementById('modalContent');
            const vContainer = document.getElementById('videoContainer');
            const vFrame = document.getElementById('modalVideoFrame');
            const actionBtn = document.getElementById('modalActionBtn');

            vFrame.src = "";
            vContainer.classList.add('hidden');
            content.querySelector('.overflow-y-auto').scrollTop = 0;

            document.getElementById('modalTitle').innerText = name;
            document.getElementById('modalOwner').innerHTML = `<i class="fa-solid fa-store mr-1"></i> ${owner}`;
            document.getElementById('modalDescription').innerHTML = detail;
            document.getElementById('modalImage').src = image;
            document.getElementById('modalPrice').innerText = price;

            actionBtn.href = actionUrl;
            actionBtn.className = `w-full py-4 rounded-2xl shadow-lg flex items-center justify-center gap-3 text-white font-bold transition-transform active:scale-95 min-h-[56px] ${btnClass}`;
            document.getElementById('modalActionText').innerText = btnText;
            document.getElementById('modalActionIcon').className = `fa-solid ${btnIcon}`;

            const setupLink = (id, value, prefix = '') => {
                const el = document.getElementById(id);
                if (!isInvalidValue(value)) {
                    el.href = prefix + value;
                    el.classList.remove('hidden');
                } else {
                    el.classList.add('hidden');
                }
            };
            setupLink('linkTel', tel, 'tel:');
            setupLink('linkLine', line && (line.startsWith('http') ? line : `https://line.me/ti/p/~${line}`));
            setupLink('linkFB', fb);
            setupLink('linkTikTok', tiktok);
            setupLink('linkEmail', email, 'mailto:');

            modal.classList.remove('hidden');
            setTimeout(() => content.classList.remove('translate-y-full'), 10);
            document.body.style.overflow = 'hidden';

            if (sCode) {
                try {
                    const response = await fetch(`/api/product-detail/${sCode}`);
                    const result = await response.json();
                    
                    const fullData = result.data; 

                    if (fullData && !isInvalidValue(fullData.serviceVideo)) {
                        const videoUrl = fullData.serviceVideo;
                        const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
                        const match = videoUrl.match(regExp);
                        const videoId = (match && match[2].length === 11) ? match[2] : null;

                        if (videoId) {
                            vFrame.src = `https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1`;
                            vContainer.classList.remove('hidden');
                        }
                    }

                    if (fullData?.serviceOrder?.OrderLink && !isInvalidValue(fullData.serviceOrder.OrderLink)) {
                        actionBtn.href = fullData.serviceOrder.OrderLink;
                        actionBtn.className = actionBtn.className.replace(/bg-\S+/, 'bg-green-600');
                        document.getElementById('modalActionText').innerText = 'ซื้อเลย';
                        document.getElementById('modalActionIcon').className = 'fa-solid fa-cart-shopping';
                    }
                } catch (error) {
                    console.error("Fetch API Error:", error);
                }
            }

            document.getElementById('modalShareBtn').onclick = (e) => {
                e.preventDefault();
                const shareUrl = `${window.location.origin}/shop?open=${sCode}`; 
                if (navigator.share) {
                    navigator.share({ 
                        title: name, 
                        text: `ดูรายละเอียด ${name} ที่ตลาดชุมชน`,
                        url: shareUrl 
                    }).catch(() => {});
                } else {
                    navigator.clipboard.writeText(shareUrl);
                    alert('คัดลอกลิงก์แชร์แล้ว!');
                }
            };
        }

        function closeProductModal() {
            const modal = document.getElementById('productModal');
            const content = document.getElementById('modalContent');
            document.getElementById('modalVideoFrame').src = ""; 
            content.classList.add('translate-y-full');
            setTimeout(() => {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }, 300);
        }
       
        window.addEventListener('load', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const openCode = urlParams.get('open');
            if (openCode) {
                const target = document.querySelector(`[onclick*="${openCode}"]`);
                if (target) target.click();
            }
        });
    </script>
</body>
</html>