<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= appName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body { font-family: 'Kanit', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        
        #splash-screen {
            position: fixed; inset: 0; z-index: 9999;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            background: radial-gradient(circle at center, #6366f1 0%, #4f46e5 100%);
        }
        .splash-played #splash-screen { display: none !important; }
        .logo-circle {
            width: 100px; height: 100px; background: white; border-radius: 35px;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            animation: speed-in 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        @keyframes speed-in {
            0% { transform: translateX(-200%) rotate(-20deg); opacity: 0; }
            100% { transform: translateX(0) rotate(0deg); opacity: 1; }
        }
        .is-loading { overflow: hidden; height: 100vh; }
        .splash-fade-out { opacity: 0; pointer-events: none; transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1); transform: scale(1.1); }
        @keyframes loading {
            0% { transform: scaleX(0); }
            50% { transform: scaleX(1); transform-origin: left; }
            51% { transform-origin: right; }
            100% { transform: scaleX(0); transform-origin: right; }
        }
    </style>

    <script>
        if (sessionStorage.getItem('splashPlayed')) {
            document.documentElement.classList.add('splash-played');
        }
    </script>
</head>
<body class="bg-gray-50 pb-28">

    <div id="splash-screen">
        <div class="logo-container relative flex items-center justify-center">
            <div class="rainbow-track absolute w-[140px] h-[140px] border-[4px] border-transparent border-t-yellow-400 border-r-red-400 rounded-full animate-[spin_2s_linear_infinite] opacity-40"></div>
            <div class="logo-circle">
                <i class="fa-solid fa-rainbow text-5xl bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 bg-clip-text text-transparent"></i>
            </div>
        </div>
        <div class="brand-text mt-6 text-center animate-[fade-up_1s_ease-out]">
            <h1 class="text-white text-3xl font-black tracking-tight italic uppercase">BURIRAM <span class="text-yellow-400">GO!</span></h1>
            <p class="text-[10px] text-indigo-100 font-bold uppercase tracking-[0.2em] mt-2">Sport & Speed City</p>
        </div>
        <div class="absolute bottom-16 w-32 h-1.5 bg-white/10 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-yellow-400 to-orange-500 w-full origin-left animate-[loading_1.8s_ease-in-out_infinite]"></div>
        </div>
    </div>

    <header class="bg-indigo-600 px-6 pt-10 pb-14 rounded-b-[45px] shadow-lg relative">
        <div class="flex justify-between items-center text-white">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-md border border-white/30">
                    <i class="fa-solid fa-rainbow text-lg"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold leading-none uppercase">BURIRAM GO</h1>
                    <p class="text-[9px] text-indigo-200 font-medium mt-1">Sport & Speed City</p>
                </div>
            </div>
        </div>
        <form action="/" method="GET" class="absolute -bottom-6 left-6 right-6 bg-white rounded-2xl shadow-xl flex items-center px-5 py-3.5 border border-gray-100">
            <i class="fa-solid fa-magnifying-glass text-indigo-400 mr-3 text-sm"></i>
            <input type="text" name="search" placeholder="ค้นหาข่าวสารและกิจกรรม..." class="bg-transparent border-none outline-none text-xs w-full text-gray-600 font-medium">
        </form>
    </header>

    <main class="mt-12 px-6">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="font-bold text-gray-800 text-lg uppercase italic tracking-tight">Latest <span class="text-indigo-600">News</span></h2>
                <p class="text-[10px] text-gray-400 font-medium italic">Auto-sync with Facebook</p>
            </div>
            <div class="w-9 h-9 bg-blue-50 rounded-2xl flex items-center justify-center border border-blue-100 shadow-sm">
                <i class="fa-brands fa-facebook-f text-blue-600 text-sm"></i>
            </div>
        </div>

        <div id="auto-news-container" class="space-y-4">
            <div class="animate-pulse space-y-4 skeleton-loader">
                <% for(let i=0; i<6; i++) { %>
                <div class="bg-white p-3 rounded-[35px] border border-gray-100 flex items-center gap-4">
                    <div class="w-20 h-20 bg-gray-200 rounded-[25px]"></div>
                    <div class="flex-1 space-y-2">
                        <div class="h-2 bg-gray-200 rounded w-1/4"></div>
                        <div class="h-3 bg-gray-200 rounded w-full"></div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('partials/nav', { currentPage: 'home' }) %>

    <script>
        async function fetchAutoNews() {
            const APIFY_URL = '<%= fbApiUrl %>';
            
            try {
                const response = await fetch(APIFY_URL);
                const data = await response.json();
                const container = document.getElementById('auto-news-container');

                if (Array.isArray(data) && data.length > 0) {
                    container.innerHTML = ''; 
                    
                    data.reverse().slice(0, 15).forEach(item => {
                        const date = item.time ? new Date(item.time).toLocaleDateString('th-TH', {
                            day: 'numeric', month: 'short', year: '2-digit'
                        }) : 'ข่าวล่าสุด';

                        let rawImage = '';

                        // 1. เช็ค Media หลัก
                        if (item.media && item.media[0]) {
                            rawImage = item.media[0].photo_image?.uri || item.media[0].thumbnail;
                        }

                        // 2. เช็ค Attachments (อัลบั้มภาพ)
                        if (!rawImage && item.attachments && item.attachments[0]) {
                            const att = item.attachments[0];
                            rawImage = att.media?.image?.uri || 
                                       att.target?.preview_image?.uri || 
                                       (att.subattachments && att.subattachments[0]?.media?.image?.uri);
                        }
                        
                        // 3. เช็ค Shared Post
                        if (!rawImage && item.sharedPost) {
                            const sp = item.sharedPost;
                            rawImage = (sp.media && sp.media[0]?.photo_image?.uri) || 
                                       (sp.attachments && sp.attachments[0]?.media?.image?.uri) ||
                                       (sp.attachments && sp.attachments[0]?.subattachments && sp.attachments[0].subattachments[0]?.media?.image?.uri);
                        }

                        // 4. ถ้ายังไม่มีรูปภาพ ให้ใช้รูปโปรไฟล์ของเพจแทน (ตามโจทย์)
                        if (!rawImage && item.user && item.user.profilePic) {
                            rawImage = item.user.profilePic;
                        }

                        const image = rawImage 
                            ? `https://images.weserv.nl/?url=${encodeURIComponent(rawImage)}&w=300&h=300&fit=cover&output=jpg` 
                            : 'https://via.placeholder.com/300x300?text=TAT+Buriram';

                        const rawText = item.text || (item.sharedPost && item.sharedPost.text) || item.caption || 'ข่าวประชาสัมพันธ์จาก ททท. บุรีรัมย์';
                        const title = rawText.length > 85 ? rawText.substring(0, 85) + '...' : rawText;

                        const card = `
                            <div onclick="window.open('${item.url}', '_blank')" class="bg-white p-3 rounded-[35px] shadow-sm border border-gray-100 flex items-center gap-4 active:scale-95 transition-all duration-300 cursor-pointer">
                                <div class="relative min-w-[85px]">
                                    <img src="${image}" class="w-20 h-20 rounded-[25px] object-cover shadow-sm bg-gray-50" 
                                         onerror="this.onerror=null; this.src='https://via.placeholder.com/300x300?text=News';">
                                    <div class="absolute -top-1 -right-1 w-6 h-6 bg-blue-600 rounded-full border-2 border-white flex items-center justify-center">
                                        <i class="fa-brands fa-facebook-f text-[10px] text-white"></i>
                                    </div>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 mb-1.5">
                                        <span class="text-[9px] font-black text-indigo-600 uppercase tracking-tighter">Facebook News</span>
                                        <span class="text-[9px] text-gray-400 font-medium">${date}</span>
                                    </div>
                                    <h3 class="font-bold text-gray-800 text-[11px] line-clamp-2 leading-snug">
                                        ${title}
                                    </h3>
                                    <div class="flex items-center mt-2 text-blue-500 text-[9px] font-bold">
                                        <span>ดูรายละเอียด</span>
                                        <i class="fa-solid fa-arrow-right ml-1 text-[7px]"></i>
                                    </div>
                                </div>
                            </div>
                        `;
                        container.innerHTML += card;
                    });
                } else {
                    container.innerHTML = '<p class="text-center text-xs text-gray-400 py-20">ไม่พบข้อมูลข่าวสารในขณะนี้</p>';
                }
            } catch (error) {
                console.error('Fetch Error:', error);
                document.getElementById('auto-news-container').innerHTML = '<p class="text-center text-xs text-gray-400 py-20">ขออภัย ไม่สามารถโหลดข้อมูลได้ในขณะนี้</p>';
            }
        }

        (function() {
            const splash = document.getElementById('splash-screen');
            fetchAutoNews(); 

            if (sessionStorage.getItem('splashPlayed')) {
                if (splash) splash.remove();
            } else {
                document.body.classList.add('is-loading');
                window.addEventListener('load', () => {
                    setTimeout(() => {
                        if (splash) {
                            splash.classList.add('splash-fade-out');
                            sessionStorage.setItem('splashPlayed', 'true');
                            setTimeout(() => { 
                                splash.remove(); 
                                document.body.classList.remove('is-loading'); 
                            }, 600);
                        }
                    }, 1800);
                });
            }
        })();
    </script>
</body>
</html>